# Django BFF 地址（所有 API 请求只走 8001，不直连 FastAPI 8000）
# 开发环境使用相对路径，由 Vite 代理到 Django
VITE_API_BASE_URL=/api

# WebSocket 路径（开发环境由 Vite 代理到 Django 8001）
VITE_WS_BASE_URL=

# Vite 开发服务器代理目标（仅 dev 使用）
VITE_DJANGO_BACKEND_URL=http://localhost:8001

# 工作台与业务应用入口（false 可回退到旧入口；修改后重新构建）
VITE_WORKBENCH_ENABLED=true
VITE_OFFICIAL_DOCUMENTS_ENABLED=true
