    "scope": "Local syntax compatibility patch, not upstream source or a new standard revision. No feature/default/identity/constraint additions.",
    "edits": [
      {
        "reason": "Declare the two prefixes already used by date-and-time and uri types.",
        "before": "  organization\n",
        "after": "  import ietf-yang-types {\n    prefix yang;\n  }\n\n  import ietf-inet-types {\n    prefix inet;\n  }\n\n  organization\n"
      },
      {
        "reason": "Keep the existing entire hybrid-link description inside its quoted argument.",
        "before": "\"Hybrid links, combination of the other three\"\n",
        "after": "\"Hybrid links, combination of the other three\n"
      },
      {
        "reason": "Close the linked-termination-point list before closing its top-level augment.",
        "before": "      uses nt:tp-ref;\n  }\n",
        "after": "      uses nt:tp-ref;\n    }\n  }\n"
      },
      {
        "reason": "Close the linked-node list before closing its top-level augment.",
        "before": "      uses nw:node-ref;\n  }\n",
        "after": "      uses nw:node-ref;\n    }\n  }\n"
      }
    ]
  },
