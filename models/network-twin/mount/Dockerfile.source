FROM python@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0
RUN apt-get update && apt-get install -y --no-install-recommends cmake build-essential libpcre2-dev
COPY libyang.tar.gz /src/libyang.tar.gz
RUN echo '08ea468f57f86c26920a76f7d8210809e428be791b05e7b67b8d60f2ba0bdf9f  /src/libyang.tar.gz' | sha256sum -c - \
    && tar -xzf /src/libyang.tar.gz -C /src \
    && cmake -S /src/libyang-47351e59e2965e350f9d4098f15ecbe6b3850f6f -B /build -DCMAKE_BUILD_TYPE=Release -DENABLE_TESTS=OFF \
    && cmake --build /build -j 2 \
    && cmake --install /build \
    && ldconfig
WORKDIR /work
ENTRYPOINT ["yanglint"]
