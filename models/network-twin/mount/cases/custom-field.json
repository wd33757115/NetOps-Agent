{
  "ietf-interfaces:interfaces": {
    "interface": [
      {
        "name": "eth0",
        "type": "iana-if-type:ethernetCsmacd",
        "ietf-network-instance:bind-ni-name": "blue"
      },
      {
        "name": "eth1",
        "type": "iana-if-type:ethernetCsmacd",
        "ietf-network-instance:bind-ni-name": "red"
      }
    ]
  },
  "ietf-network-instance:network-instances": {
    "network-instance": [
      {
        "name": "blue",
        "vrf-root": {
          "ietf-routing:routing": {
            "control-plane-protocols": {
              "control-plane-protocol": [
                {
                  "type": "ietf-routing:static",
                  "name": "static",
                  "static-routes": {
                    "ietf-ipv4-unicast-routing:ipv4": {
                      "route": [
                        {
                          "destination-prefix": "192.0.2.0/24",
                          "next-hop": {
                            "outgoing-interface": "eth0"
                          },
                          "project-confidence": 0.8
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      {
        "name": "red",
        "vrf-root": {
          "ietf-routing:routing": {
            "control-plane-protocols": {
              "control-plane-protocol": [
                {
                  "type": "ietf-routing:static",
                  "name": "static",
                  "static-routes": {
                    "ietf-ipv4-unicast-routing:ipv4": {
                      "route": [
                        {
                          "destination-prefix": "192.0.2.0/24",
                          "next-hop": {
                            "outgoing-interface": "eth1"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    ]
  }
}
