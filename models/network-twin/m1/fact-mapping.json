   },
   "type": {
    "path": "/ietf-interfaces:interfaces/interface/type",
    "status": "derived",
    "note": "platform interface kind → iana-if-type identity (ethernetCsmacd, ieee8023adLag, l3ipvlan, softwareLoopback)"
   },
   "admin_status": {
    "path": "/ietf-interfaces:interfaces/interface/enabled",
    "status": "derived",
    "note": "shutdown is the configured state (RFC 8343 enabled); admin-status needs the if-mib feature and with it a mandatory if-index"
   },
   "oper_status": {
