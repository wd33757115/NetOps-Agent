{
 "scope": "M1-5: every field the platform parsers collect today (topology profile facts of H3C Comware 7 and Cisco IOS, see tests/fixtures/topology/campus-wan) mapped to the standard data node that holds it. Paths are RFC 7951 member paths without keys; scripts/topology/m1_mapping.py checks that each exists in a compiled baseline set and whether a current producer emits it. No project-defined node is introduced.",
 "statuses": {
  "native": "a standard node holds exactly this value (format conversion only)",
  "derived": "a standard node holds it after a defined derivation (enumeration/identity mapping, name→reference)",
  "context": "scopes other nodes (which network instance / RIB / interface the rows belong to)",
  "key-blocked": "the standard node exists but its list key or reference cannot be filled from what is collected",
  "no-native-node": "no node in the baseline sets; kept as evidence outside the YANG tree"
 },
 "facts": {
  "interfaces": {
   "ifname": {"path": "/ietf-interfaces:interfaces/interface/name", "status": "native"},
   "type": {"path": "/ietf-interfaces:interfaces/interface/type", "status": "derived", "note": "platform interface kind → iana-if-type identity (ethernetCsmacd, ieee8023adLag, l3ipvlan, softwareLoopback)"},
   "admin_status": {"path": "/ietf-interfaces:interfaces/interface/admin-status", "status": "native", "note": "state value; the configured value is interface/enabled"},
   "oper_status": {"path": "/ietf-interfaces:interfaces/interface/oper-status", "status": "native"},
   "description": {"path": "/ietf-interfaces:interfaces/interface/description", "status": "native"},
   "raw_name": {"status": "no-native-node", "note": "CLI abbreviation (Et0/1) of the full name; presentation evidence only"}
  },
  "ip": {
   "ifname": {"path": "/ietf-interfaces:interfaces/interface/name", "status": "native"},
   "address": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/address/ip", "status": "native", "note": "IPv6 rows go to ietf-ip:ipv6/address/ip"},
   "prefix_len": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/address/prefix-length", "status": "native"},
   "vrf": {"path": "/ietf-interfaces:interfaces/interface/ietf-network-instance:bind-ni-name", "status": "context", "note": "and /ietf-network-instance:network-instances/network-instance/name; 'default' is the global instance, not a named NI"}
  },
  "arp": {
   "ifname": {"path": "/ietf-interfaces:interfaces/interface/name", "status": "native"},
   "ip": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/neighbor/ip", "status": "native"},
   "mac": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/neighbor/link-layer-address", "status": "native"},
   "type": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/neighbor/origin", "status": "derived", "note": "dynamic/static → origin dynamic/static; interface-own entries → other"},
   "age_s": {"status": "no-native-node", "note": "RFC 8344 neighbor has no age or expiry leaf"},
   "vrf": {"path": "/ietf-interfaces:interfaces/interface/ietf-network-instance:bind-ni-name", "status": "context"}
  },
  "mac": {
   "mac": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/filtering-database/filtering-entry/address", "status": "key-blocked", "note": "list key also needs database-id; not shown by the CLI"},
   "vlan_or_bd": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/filtering-database/filtering-entry/vids", "status": "key-blocked"},
   "port": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/filtering-database/filtering-entry/port-map/port-ref", "status": "key-blocked", "note": "port-ref is the bridge port number; the CLI gives the interface name and no port number"},
   "type": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/filtering-database/filtering-entry/entry-type", "status": "derived", "note": "static/dynamic"}
  },
  "vlan": {
   "vlan_id": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/vid", "status": "native"},
   "name": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/name", "status": "native"}
  },
  "vlan_members": {
   "vlan_id": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/vid", "status": "native"},
   "ports": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/egress-ports", "status": "native", "note": "untagged members also in untagged-ports"},
   "status": {"status": "no-native-node", "note": "VLAN active/suspended has no IEEE 802.1Q YANG leaf"}
  },
  "trunk.ports[]": {
   "ifname": {"path": "/ietf-interfaces:interfaces/interface/name", "status": "native"},
   "l2_mode": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/untagged-ports", "status": "derived", "note": "trunk/access is not a leaf in 802.1Q; it is the port's tagged/untagged membership"},
   "encapsulation": {"path": "/ietf-interfaces:interfaces/interface/ieee802-dot1q-bridge:bridge-port/port-type", "status": "derived", "note": "802.1Q tagging on a customer bridge port → c-vlan-bridge-port"},
   "native_vlan": {"path": "/ietf-interfaces:interfaces/interface/ieee802-dot1q-bridge:bridge-port/pvid", "status": "native"},
   "trunk_vlans": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/egress-ports", "status": "derived", "note": "allowed list → membership of each VLAN"},
   "forwarding_vlans": {"path": "/ietf-interfaces:interfaces/interface/ieee802-dot1q-bridge:bridge-port/ieee802-dot1q-mstp-bridge:port-mstp/msti", "status": "derived", "note": "VLANs whose spanning-tree instance forwards on the port; needs the VLAN→MSTI map and per-MSTI port state"},
   "active_vlans": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/egress-ports", "status": "derived", "note": "allowed and existing VLANs"},
   "raw_name": {"status": "no-native-node", "note": "CLI abbreviation"}
  },
  "switchport.ports[]": {
   "ifname": {"path": "/ietf-interfaces:interfaces/interface/name", "status": "native"},
   "admin_mode": {"status": "no-native-node", "note": "Cisco DTP administrative mode (dynamic auto/desirable); no IEEE/IETF node"},
   "oper_mode": {"status": "no-native-node", "note": "DTP negotiation result; bundle membership goes to the LAG model"},
   "access_vlan": {"path": "/ietf-interfaces:interfaces/interface/ieee802-dot1q-bridge:bridge-port/pvid", "status": "native", "note": "for an access port"},
   "native_vlan": {"path": "/ietf-interfaces:interfaces/interface/ieee802-dot1q-bridge:bridge-port/pvid", "status": "native", "note": "for a trunk port"},
   "pvid": {"path": "/ietf-interfaces:interfaces/interface/ieee802-dot1q-bridge:bridge-port/pvid", "status": "native"},
   "trunk_vlans": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/egress-ports", "status": "derived"},
   "admin_native_tagged": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/untagged-ports", "status": "derived", "note": "native VLAN tagged = port absent from untagged-ports of the PVID VLAN"},
   "lag_parent": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/egress-ports", "status": "derived", "note": "placeholder until the LAG model check below; see lag.members"},
   "encapsulation": {"path": "/ietf-interfaces:interfaces/interface/ieee802-dot1q-bridge:bridge-port/port-type", "status": "derived"},
   "l2_mode": {"path": "/ieee802-dot1q-bridge:bridges/bridge/component/bridge-vlan/vlan/untagged-ports", "status": "derived"},
   "raw_name": {"status": "no-native-node", "note": "CLI abbreviation"}
  },
  "lag": {
   "ifname": {"path": "/ietf-interfaces:interfaces/interface/name", "status": "native", "note": "the aggregator interface, type ieee8023adLag"},
   "members": {"path": "/ietf-network:networks/network/node/ietf-network-topology:termination-point/ietf-l2-topology:l2-termination-point-attributes/member-link-tp", "status": "derived", "note": "network view (RFC 8944); the device view is IEEE 802.1AX aggregation-port"},
   "bundled": {"status": "no-native-node", "note": "placeholder until the IEEE 802.1AX aggregation-port state is checked"}
  },
  "lldp": {
   "local_if": {"path": "/ieee802-dot1ab-lldp:lldp/port/name", "status": "key-blocked", "note": "port list key also needs dest-mac-address (agent); nearest-bridge is assumed only with evidence"},
   "remote_chassis_id": {"path": "/ieee802-dot1ab-lldp:lldp/port/remote-systems-data/chassis-id", "status": "key-blocked", "note": "remote-systems-data keys time-mark and remote-index are not collected"},
   "remote_chassis_subtype": {"path": "/ieee802-dot1ab-lldp:lldp/port/remote-systems-data/chassis-id-subtype", "status": "key-blocked"},
   "remote_port_id": {"path": "/ieee802-dot1ab-lldp:lldp/port/remote-systems-data/port-id", "status": "key-blocked"},
   "remote_port_subtype": {"path": "/ieee802-dot1ab-lldp:lldp/port/remote-systems-data/port-id-subtype", "status": "key-blocked"},
   "remote_sysname": {"path": "/ieee802-dot1ab-lldp:lldp/port/remote-systems-data/system-name", "status": "key-blocked"},
   "remote_system_description": {"path": "/ieee802-dot1ab-lldp:lldp/port/remote-systems-data/system-description", "status": "key-blocked"},
   "remote_mgmt_addresses": {"path": "/ieee802-dot1ab-lldp:lldp/port/remote-systems-data/management-address/address", "status": "key-blocked", "note": "hex octet string with address-subtype"}
  },
  "lldp_local": {
   "chassis_id": {"path": "/ieee802-dot1ab-lldp:lldp/local-system-data/chassis-id", "status": "native"},
   "hostname": {"path": "/ieee802-dot1ab-lldp:lldp/local-system-data/system-name", "status": "native", "note": "also /ietf-system:system/hostname"},
   "system_description": {"path": "/ieee802-dot1ab-lldp:lldp/local-system-data/system-description", "status": "native"},
   "management_addresses": {"path": "/ieee802-dot1ab-lldp:lldp/port/management-address-tx-port/man-address", "status": "key-blocked", "note": "IEEE 802.1AB keeps local management addresses per transmitting port (port keys name + dest-mac-address), as hex octets with address-subtype"},
   "vendor": {"path": "/ietf-network-inventory:network-inventory/network-elements/network-element/mfg-name", "status": "native"},
   "model": {"path": "/ietf-network-inventory:network-inventory/network-elements/network-element/product-name", "status": "native"},
   "serial": {"path": "/ietf-network-inventory:network-inventory/network-elements/network-element/components/component/serial-number", "status": "key-blocked", "note": "belongs to a chassis component whose component-id is not collected"}
  },
  "routes": {
   "prefix": {"path": "/ietf-routing:routing/ribs/rib/routes/route/ietf-ipv4-unicast-routing:destination-prefix", "status": "native"},
   "protocol": {"path": "/ietf-routing:routing/ribs/rib/routes/route/source-protocol", "status": "derived", "note": "CLI protocol code → routing-protocol identity"},
   "preference": {"path": "/ietf-routing:routing/ribs/rib/routes/route/route-preference", "status": "native"},
   "metric": {"path": "/ietf-routing:routing/ribs/rib/routes/route/ietf-ospf:metric", "status": "derived", "note": "only OSPF routes have a metric node (RFC 9129); static/BGP metrics have none in RFC 8349"},
   "next_hops[].ip": {"path": "/ietf-routing:routing/ribs/rib/routes/route/next-hop/ietf-ipv4-unicast-routing:next-hop-address", "status": "native", "note": "several next hops: next-hop-list/next-hop/ietf-ipv4-unicast-routing:address"},
   "next_hops[].ifname": {"path": "/ietf-routing:routing/ribs/rib/routes/route/next-hop/outgoing-interface", "status": "native"},
   "next_hops[].vrf": {"path": "/ietf-network-instance:network-instances/network-instance/name", "status": "context", "note": "next hop resolved in another instance (route leaking)"},
   "vrf": {"path": "/ietf-network-instance:network-instances/network-instance/name", "status": "context", "note": "each NI holds its own RIB under its schema mount (RFC 8529/8528)"}
  },
  "vrrp": {
   "ifname": {"path": "/ietf-interfaces:interfaces/interface/name", "status": "native"},
   "vrid": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/ietf-vrrp:vrrp/vrrp-instance/vrid", "status": "native"},
   "priority": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/ietf-vrrp:vrrp/vrrp-instance/priority", "status": "native"},
   "state": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/ietf-vrrp:vrrp/vrrp-instance/state", "status": "derived", "note": "Initialize/Backup/Master → identity"},
   "virtual_addresses": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/ietf-vrrp:vrrp/vrrp-instance/virtual-ipv4-addresses/virtual-ipv4-address/ipv4-address", "status": "native"},
   "last_adv_source": {"path": "/ietf-interfaces:interfaces/interface/ietf-ip:ipv4/ietf-vrrp:vrrp/vrrp-instance/last-adv-source", "status": "native"}
  }
 }
}
