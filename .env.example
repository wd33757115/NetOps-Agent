#
# NetOps Agent 环境变量模板（复制为 .env 后修改）
# 生产环境：务必更换所有密钥与默认密码

# ── LLM（必填）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_SECONDS=240
PARSER_MODEL_REQUEST_HARD_TIMEOUT_SECONDS=480
PARSER_GENERATION_TOTAL_TIMEOUT_SECONDS=1500
PARSER_MODEL_CALL_HEARTBEAT_SECONDS=15
PARSER_LLM_MAX_COMPLETION_TOKENS=32768
PARSER_LLM_REVIEW_MAX_COMPLETION_TOKENS=8192
# Optional; empty reuses JWT_SECRET_KEY for stable, non-reversible sample aliases.
PARSER_SANITIZATION_SECRET=
PARSER_GENERATION_TASK_SOFT_TIME_LIMIT_SECONDS=1740
PARSER_GENERATION_TASK_TIME_LIMIT_SECONDS=1800

# ── 安全（生产必改）──
SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_SECRET_KEY=change-me-same-as-secret-or-dedicated
# 可选；留空时复用 JWT_SECRET_KEY。生产环境可使用独立 HMAC 密钥。
CHECK_ITEM_RESULT_CURSOR_SECRET=
CHECK_ITEM_RESULT_CURSOR_TTL_SECONDS=3600
CHECK_ITEM_RESULT_MAX_OFFSET=1000
JWT_ALGORITHM=HS256
ENFORCE_BFF_ORIGIN=true
BFF_REQUIRE_AUTH=true

# ── Django ──
DJANGO_DEBUG=false
# Linux/Docker：浏览器访问工作台用的服务器 IP 或域名都要列在这里（逗号分隔）。
# Windows 部署由前端代理转发，保持 localhost,127.0.0.1 即可。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=netops_agent
POSTGRES_USER=netops
POSTGRES_PASSWORD=change-me-strong-password
# Per-engine pool budget (sync and async each have a pool). Windows workers use 3+2.
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT=10
POSTGRES_CONNECT_TIMEOUT=10

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ── Celery ──
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
CELERY_BEAT_HEARTBEAT_INTERVAL_SECONDS=15
CELERY_BEAT_HEARTBEAT_STALE_AFTER_SECONDS=45
CELERY_BEAT_HEARTBEAT_TTL_SECONDS=180

# ── MinIO ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET_NAME=netops-files

# 巡检 Snapshot / Change / Event SQLite（MVP）
PATROL_SNAPSHOT_DB=src/skills/shared/databases/patrol.db
PARSER_VALIDATION_DB=src/skills/shared/databases/parser-validation.db

# ── FastAPI / 应用 ──
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Skill Catalog + 分级路由（Phase 2）
SKILL_CATALOG_ENABLED=true
SKILL_CATALOG_USE_TIERED_ROUTING=true
# 默认使用触发词、标签和权限路由；本地语义模型按需显式启用。
SKILL_CATALOG_SEMANTIC_ROUTING_ENABLED=false
SKILL_CATALOG_SEMANTIC_MIN_SCORE=0.72
# 默认仅同步元数据；向量重建通过控制面触发，避免网关启动加载重型模型。
PRE_PROCESS_TOP_K=5
PRE_PROCESS_HARD_LIMIT=8
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
SKILL_RATE_LIMIT_ENABLED=true
SKILL_RATE_LIMIT_PER_USER=30
SKILL_RATE_LIMIT_PER_SKILL=200

# Skill 治理与归档（Phase 3）
SKILL_GOVERNANCE_ENABLED=true
PLATFORM_VERSION=1.0.0
SKILL_EXEC_ARCHIVE_ENABLED=true
SKILL_EXEC_ARCHIVE_AFTER_DAYS=90
SKILL_EXEC_ARCHIVE_BATCH_SIZE=500

# Redis Streams EventBus（Phase 1）
EVENT_BUS_ENABLED=true
EVENT_BUS_STREAM_MAXLEN=100000
EVENT_BUS_CONSUMER_BATCH_SIZE=20
EVENT_BUS_CONSUMER_BLOCK_MS=500
EVENT_BUS_POLL_IDLE_SEC=1.0
# true=EventBus 与 DB 通知双写（Consumer 未启动时仍能收到站内信）；false=仅 EventBus 投递
EVENT_BUS_DIRECT_NOTIFY_FALLBACK=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ── 公网入口（下载链接 / ITSM 回调附件，无尾斜杠）──
# 生产示例：https://netops.example.com
# 留空则生成同源相对路径 /api/artifacts/download/...（浏览器与 React 同域时可用）
PUBLIC_APP_URL=

# ── BFF 代理（Django 容器内填 fastapi:8000）──
FASTAPI_BASE_URL=http://localhost:8000

# ── CORS（生产填实际前端域名，逗号分隔）──
# CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── Langfuse（可选，未配置则自动降级）──
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# ── ITSM ──
ITSM_WEBHOOK_SECRET=change-me-itsm-secret
# ITSM_CALLBACK_URL=

# ── 限流（可选）──
# BFF_RATE_LIMIT_CHAT=30
# BFF_RATE_LIMIT_DEFAULT=60
# BFF_RATE_LIMIT_IN_DEBUG=false

# ── Skill 路由 ──
# SEMANTIC_SKILL_MIN_CONFIDENCE=0.72
# CHAT_GRAPH_TIMEOUT=170
# Patrol execution and event-rule runtime governance
PARSER_BACKFILL_ENABLED=false
PATROL_MAX_CONCURRENCY=50
PATROL_SITE_MAX_CONCURRENCY=10
PATROL_DISTRIBUTED_CONCURRENCY_ENABLED=true
PATROL_CONCURRENCY_LEASE_SECONDS=180
PATROL_CONCURRENCY_WAIT_SECONDS=60
PATROL_RUN_LEASE_SECONDS=900
PATROL_WORKFLOW_RUNNING_STALE_SECONDS=900
PATROL_WORKFLOW_QUEUED_STALE_SECONDS=14400
PATROL_OFFLINE_CURRENT_MAX_AGE_HOURS=24
PATROL_CURRENT_AUTHORITY_REQUEST_TTL_HOURS=4
REDIS_RECONNECT_BACKOFF_SECONDS=5
EVENT_RULE_ALLOW_BUILTIN_FALLBACK=false
# Capability packages: same random secret (at least 32 characters) on Django,
# Gateway and Workers. Required for worker/tool authorization; never sent to UI.
NETOPS_APP_INTERNAL_SECRET=
NETOPS_AUTHORITY_URL=http://127.0.0.1:8001

# Per authenticated user / 60 seconds; unauthenticated IPs stay limited to 60.
BFF_RATE_LIMIT_DEFAULT=600
BFF_RATE_LIMIT_CHAT=30
BFF_RATE_LIMIT_WINDOW=60

# New independent device access / topology Apps. No inspection credential reuse.
# Generate once with Fernet.generate_key(); identical secret on Gateway and workers.
DEVICE_ACCESS_CREDENTIAL_KEY=
# Absolute service-side paths. Grants JSON and known_hosts are operator managed.
DEVICE_ACCESS_GRANTS_FILE=
DEVICE_ACCESS_KNOWN_HOSTS=
