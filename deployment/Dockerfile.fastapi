FROM python:3.11-slim

ARG REQUIREMENTS_FILE=deployment/requirements/gateway.txt

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TZ=Asia/Shanghai

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制角色依赖清单
COPY requirements.txt /app/
COPY deployment/requirements /app/deployment/requirements
COPY web/django_backend/requirements.txt /app/web/django_backend/requirements.txt
COPY src/__init__.py /app/src/__init__.py
COPY src/platform /app/src/platform
COPY src/apps /app/src/apps

# 安装 Python 依赖（只在构建时执行一次）
RUN python -m src.platform.kernel.build_constraints --output /tmp/app-requirements.lock \
    && pip install --no-cache-dir -r ${REQUIREMENTS_FILE} -r /tmp/app-requirements.lock

# 复制项目文件
COPY . /app/

# 暴露端口
EXPOSE 8000

# 运行 FastAPI
CMD ["python", "-m", "uvicorn", "src.gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
