# Repository distribution: source, manuals and installation/operation scripts.
# New root directories are local until explicitly allowed here.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.editorconfig
!/.env.example
!/.github/
!/LICENSE
!/README.md
!/alembic.ini
!/pyproject.toml
!/requirements*.txt
!/src/
!/web/
!/migrations/
!/schemas/
!/config/
!/scripts/
!/deployment/
!/docs/

# Local plans, review output and historical validation notes (keep on disk).

# Database exports and process/runtime artifacts, including nested locations.
