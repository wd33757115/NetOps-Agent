Value Filldown SCOPE (Slot \d+ CPU \d+|Chassis self)
Value Required SLOT_TYPE (Slot|Subslot|Fan|Power|Chassis)
Value Required SLOT_ID (\d+|self)
Value DEVICE_NAME (.+)
Value DEVICE_SERIAL_NUMBER (\S+)
Value MAC_ADDRESS (\S+)
Value MANUFACTURING_DATE (\S+)
Value VENDOR_NAME (\S+)
Value PRODUCT_ID (.+)
Value SUPPORT_STATUS (The .+)

Start
  ^\s*(?:Slot|Subslot|Fan|Power|Chassis)\s+\S+.*: -> Continue.Record
  ^\s*${SCOPE}: -> Continue
  ^\s*${SLOT_TYPE}\s+${SLOT_ID}.*:
  ^\s*DEVICE_NAME\s*:\s*${DEVICE_NAME}
  ^\s*DEVICE_SERIAL_NUMBER\s*:\s*${DEVICE_SERIAL_NUMBER}
  ^\s*MAC_ADDRESS\s*:\s*${MAC_ADDRESS}
  ^\s*MANUFACTURING_DATE\s*:\s*${MANUFACTURING_DATE}
  ^\s*VENDOR_NAME\s*:\s*${VENDOR_NAME}
  ^\s*PRODUCT ID\s*:\s*${PRODUCT_ID}
  ^\s*${SUPPORT_STATUS}
  ^__NETOPS_TEXTFSM_END_OF_INPUT_7F3A9C__ -> Record

EOF
