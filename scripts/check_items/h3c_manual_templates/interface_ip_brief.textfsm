Value Required INTERFACE (\S+)
Value PHYSICAL (\*?down|up)
Value PROTOCOL (\S+)
Value IP_ADDRESS (\d+(?:\.\d+){3})
Value PREFIX_LENGTH (\d+)
Value VPN_INSTANCE ((?!--)\S+)
Value DESCRIPTION (.*)

Start
  ^${INTERFACE}\s+${PHYSICAL}\s+${PROTOCOL}\s+(?:${IP_ADDRESS}(?:/${PREFIX_LENGTH})?|--)\s+(?:${VPN_INSTANCE}|--)(?:\s+${DESCRIPTION})?\s*$$ -> Record

EOF
