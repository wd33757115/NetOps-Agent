Value Required INTERFACE (\S+)
Value LINK (UP|DOWN|ADM|Stby)
Value PROTOCOL (\S+)
Value MAIN_IP (\S+)
Value SPEED (\S+)
Value DUPLEX (\S+)
Value TYPE (\S+)
Value VLAN_ID (\S+)
Value DESCRIPTION (.*)

Start
  ^Interface\s+Link Protocol -> Route
  ^Interface\s+Link Speed -> Bridge

Route
  ^Interface\s+Link Speed -> Bridge
  ^${INTERFACE}\s+${LINK}\s+${PROTOCOL}\s+${MAIN_IP}(?:\s+${DESCRIPTION})?\s*$$ -> Record

Bridge
  ^${INTERFACE}\s+${LINK}\s+${SPEED}\s+${DUPLEX}\s+${TYPE}\s+${VLAN_ID}(?:\s+${DESCRIPTION})?\s*$$ -> Record

EOF
