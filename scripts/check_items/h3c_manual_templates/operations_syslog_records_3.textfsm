Value Required TIMESTAMP (\w+\s+\d+\s+\d+:\d+:\d+:\d+\s+\d+)
Value HOST (\S+)
Value FACILITY (\S+)
Value SEVERITY (\d)
Value MNEMONIC ([^:]+)
Value MESSAGE (\S.*)

Start
  ^%${TIMESTAMP}\s+${HOST}\s+${FACILITY}/${SEVERITY}/${MNEMONIC}:\s*${MESSAGE} -> Record
  ^%${TIMESTAMP}\s+${HOST}\s+${FACILITY}/${SEVERITY}/${MNEMONIC}:\s*$$ -> Continuation

Continuation
  ^\s+${MESSAGE}\s*$$ -> Record Start
  ^. -> Error "Missing syslog continuation"

EOF
