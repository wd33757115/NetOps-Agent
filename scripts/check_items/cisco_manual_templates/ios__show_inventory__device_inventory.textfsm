# Adapted from ntc-templates (Apache-2.0); see NOTICE.md.
Value component_id (.*)
Value description (.*)
Value model (([\S+]+|.*))
Value hardware_version (.*)
Value serial_number ([\w+\d+]+)
Value component_type (\S+)

Start
  ^NAME:\s+"${component_id}",\s+DESCR:\s+"${description}"
  ^PID:\s+${model}.*,.*VID:\s+${hardware_version},.*SN:\s+${serial_number} -> Record
  ^PID:\s+,.*VID:\s+${hardware_version},.*SN: -> Record
  ^PID:\s+${model}.*,.*VID:\s+${hardware_version},.*SN: -> Record
  ^PID:\s+,.*VID:\s+${hardware_version},.*SN:\s+${serial_number} -> Record
  ^PID:\s+${model}.*,.*VID:\s+${hardware_version}.*
  ^PID:\s+,.*VID:\s+${hardware_version}.*
  ^.*SN:\s+${serial_number} -> Record
  ^.*SN: -> Record
  # Capture time-stamp if vty line has command time-stamping turned on
  ^Load\s+for\s+
  ^Time\s+source\s+is
