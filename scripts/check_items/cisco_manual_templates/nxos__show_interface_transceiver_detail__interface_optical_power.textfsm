Value Required,Filldown interface (Ethernet\S+)
Value channel (\d+)
Value Filldown transceiver_present (not present|present)
Value Filldown transceiver_type (.+?)
Value Filldown vendor_name (.+?)
Value Filldown part_number (.+?)
Value Filldown revision (.+?)
Value Filldown serial_number (.+?)
Value dom_supported (not supported)
Value temperature_celsius ([-+]?\d+(?:\.\d+)?)
Value temperature_high_alarm_celsius ([-+]?\d+(?:\.\d+)?)
Value temperature_low_alarm_celsius ([-+]?\d+(?:\.\d+)?)
Value temperature_high_warning_celsius ([-+]?\d+(?:\.\d+)?)
Value temperature_low_warning_celsius ([-+]?\d+(?:\.\d+)?)
Value voltage_volts ([-+]?\d+(?:\.\d+)?)
Value voltage_high_alarm_volts ([-+]?\d+(?:\.\d+)?)
Value voltage_low_alarm_volts ([-+]?\d+(?:\.\d+)?)
Value voltage_high_warning_volts ([-+]?\d+(?:\.\d+)?)
Value voltage_low_warning_volts ([-+]?\d+(?:\.\d+)?)
Value bias_current_ma ([-+]?\d+(?:\.\d+)?)
Value bias_current_high_alarm_ma ([-+]?\d+(?:\.\d+)?)
Value bias_current_low_alarm_ma ([-+]?\d+(?:\.\d+)?)
Value bias_current_high_warning_ma ([-+]?\d+(?:\.\d+)?)
Value bias_current_low_warning_ma ([-+]?\d+(?:\.\d+)?)
Value tx_power_dbm ([-+]?\d+(?:\.\d+)?)
Value tx_high_alarm_dbm ([-+]?\d+(?:\.\d+)?)
Value tx_low_alarm_dbm ([-+]?\d+(?:\.\d+)?)
Value tx_high_warning_dbm ([-+]?\d+(?:\.\d+)?)
Value tx_low_warning_dbm ([-+]?\d+(?:\.\d+)?)
Value rx_power_dbm ([-+]?\d+(?:\.\d+)?)
Value rx_high_alarm_dbm ([-+]?\d+(?:\.\d+)?)
Value rx_low_alarm_dbm ([-+]?\d+(?:\.\d+)?)
Value rx_high_warning_dbm ([-+]?\d+(?:\.\d+)?)
Value rx_low_warning_dbm ([-+]?\d+(?:\.\d+)?)

Start
  ^Ethernet\S+ -> Continue.Clearall
  ^${interface} -> Module

Module
  ^\s+transceiver is ${transceiver_present}\s*$$ -> Continue
  ^\s+transceiver is not present -> Record Start
  ^\s+type is ${transceiver_type}\s*$$
  ^\s+name is ${vendor_name}\s*$$
  ^\s+part number is ${part_number}\s*$$
  ^\s+revision is ${revision}\s*$$
  ^\s+serial number is ${serial_number}\s*$$
  ^DOM is ${dom_supported}\s*$$ -> Record Start
  ^Lane Number:\s*${channel}
  ^\s*Temperature\s+${temperature_celsius}\s+\S+\s+[+\-]*\s*${temperature_high_alarm_celsius}\s+\S+\s+${temperature_low_alarm_celsius}\s+\S+\s+${temperature_high_warning_celsius}\s+\S+\s+${temperature_low_warning_celsius}\s+\S+
  ^\s*Voltage\s+${voltage_volts}\s+\S+\s+[+\-]*\s*${voltage_high_alarm_volts}\s+\S+\s+${voltage_low_alarm_volts}\s+\S+\s+${voltage_high_warning_volts}\s+\S+\s+${voltage_low_warning_volts}\s+\S+
  ^\s*Current\s+${bias_current_ma}\s+\S+\s+[+\-]*\s*${bias_current_high_alarm_ma}\s+\S+\s+${bias_current_low_alarm_ma}\s+\S+\s+${bias_current_high_warning_ma}\s+\S+\s+${bias_current_low_warning_ma}\s+\S+
  ^\s*Tx\s+Power\s+${tx_power_dbm}\s+\S+\s+[+\-]*\s*${tx_high_alarm_dbm}\s+\S+\s+${tx_low_alarm_dbm}\s+\S+\s+${tx_high_warning_dbm}\s+\S+\s+${tx_low_warning_dbm}\s+\S+
  ^\s*Rx\s+Power\s+${rx_power_dbm}\s+\S+\s+[+\-]*\s*${rx_high_alarm_dbm}\s+\S+\s+${rx_low_alarm_dbm}\s+\S+\s+${rx_high_warning_dbm}\s+\S+\s+${rx_low_warning_dbm}\s+\S+ -> Record
  ^Ethernet\S+ -> Continue.Clearall
  ^${interface}

EOF
