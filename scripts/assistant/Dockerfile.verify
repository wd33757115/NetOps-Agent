FROM python:3.13-slim
# Verification only: no project .env, database credentials or provider key in this image.
RUN pip install --no-cache-dir deepseek-harness-sdk==0.1.5rc1 mcp==1.26.0 sse-starlette==2.4.1 \
    fastapi==0.115.14 uvicorn==0.32.1 httpx==0.28.1 PyYAML==6.0.3 SQLAlchemy==2.0.49 \
    pydantic-settings==2.14.1 python-dotenv==1.2.2 PyJWT==2.12.1 psycopg2-binary==2.9.12 \
    asyncpg==0.31.0 pytest==9.0.3 alembic==1.18.4 structlog==25.5.0 packaging==24.2
WORKDIR /work
ENV PYTHONPATH=/work PYTHONDONTWRITEBYTECODE=1 LLM_MODEL=deepseek-v4-pro
CMD ["python", "-m", "pytest", "-c", "/dev/null", "-q", "tests/unit/test_dsh_runtime.py", "tests/unit/test_assistant_diagnosis.py", "tests/unit/test_authority_session.py"]
