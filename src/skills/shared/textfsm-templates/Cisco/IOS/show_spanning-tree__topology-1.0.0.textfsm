Value Filldown INSTANCE (VLAN\d{4}|MST\d+)
Value Filldown VLAN_ID (\d{4})
Value Filldown MSTI (\d+)
Value Filldown PROTOCOL (\w+)
Value Filldown ROOT_PRIORITY (\d+)
Value Filldown ROOT_ADDRESS ([0-9a-f]{4}\.[0-9a-f]{4}\.[0-9a-f]{4})
Value Filldown ROOT_PORT (\S+)
Value Filldown IS_ROOT (This bridge is the root)
Value Filldown BRIDGE_PRIORITY (\d+)
Value Filldown BRIDGE_ADDRESS ([0-9a-f]{4}\.[0-9a-f]{4}\.[0-9a-f]{4})
Value Required INTERFACE (\S+)
Value ROLE (\w+)
Value STATE (\w+)
Value COST (\d+)
Value PORT_ID (\d+\.\d+)
Value TYPE (\S+(?:\s+\S+)*?)

# One record per spanning-tree instance and port (campus-wan lab, IOL rapid-PVST): an
# instance block ("VLAN0010" PVST, "MST0" MSTP) with its root and bridge identifiers,
# then the port table. Timer and aging lines are known and not modeled.
Start
  ^(VLAN\d{4}|MST\d+)\s*$$ -> Continue.Clearall
  ^${INSTANCE}\s*$$ -> Continue
  ^VLAN${VLAN_ID}\s*$$
  ^MST${MSTI}\s*$$
  ^\s+Spanning tree enabled protocol ${PROTOCOL}\s*$$
  ^\s+Root ID\s+Priority\s+${ROOT_PRIORITY}(\s.*)?$$ -> Root
  ^\s+Bridge ID\s+Priority\s+${BRIDGE_PRIORITY}(\s.*)?$$ -> Bridge
  ^Interface\s+Role\s+Sts\s+Cost\s+Prio\.Nbr\s+Type\s*$$ -> Ports
  ^\s*$$
  ^. -> Error "unrecognized show spanning-tree line"

Root
  ^\s+Address\s+${ROOT_ADDRESS}\s*$$
  ^\s+${IS_ROOT}\s*$$
  ^\s+Port\s+\d+\s+\(${ROOT_PORT}\)\s*$$
  ^\s+(Cost|Hello Time)\s.*$$
  ^\s+Bridge ID\s+Priority\s+${BRIDGE_PRIORITY}(\s.*)?$$ -> Bridge
  ^\s*$$ -> Start
  ^. -> Error "unrecognized root bridge line"

Bridge
  ^\s+Address\s+${BRIDGE_ADDRESS}\s*$$
  ^\s+(Hello Time|Aging Time)\s.*$$
  ^Interface\s+Role\s+Sts\s+Cost\s+Prio\.Nbr\s+Type\s*$$ -> Ports
  ^\s*$$ -> Start
  ^. -> Error "unrecognized bridge line"

Ports
  ^[-\s]+$$
  ^${INTERFACE}\s+${ROLE}\s+${STATE}\*?\s+${COST}\s+${PORT_ID}\s+${TYPE}\s*$$ -> Record
  ^(VLAN\d{4}|MST\d+)\s*$$ -> Continue.Clearall
  ^${INSTANCE}\s*$$ -> Continue
  ^VLAN${VLAN_ID}\s*$$ -> Start
  ^MST${MSTI}\s*$$ -> Start
  ^\s*$$
  ^. -> Error "unrecognized spanning-tree port row"
