Value IP_ADDRESS (\d+\.\d+\.\d+\.\d+)
Value AGE (\d+|-)
Value MAC_ADDRESS ([0-9a-fA-F]{4}\.[0-9a-fA-F]{4}\.[0-9a-fA-F]{4})
Value TYPE (\S+)
Value INTERFACE (\S+)

Start
  ^Protocol\s+Address\s+Age\s+\(min\)\s+Hardware Addr\s+Type\s+Interface\s*$$
  ^Internet\s+${IP_ADDRESS}\s+${AGE}\s+${MAC_ADDRESS}\s+${TYPE}\s+${INTERFACE}\s*$$ -> Record
  ^Internet\s+${IP_ADDRESS}\s+${AGE}\s+${MAC_ADDRESS}\s+${TYPE}\s*$$ -> Record
  # An unresolved entry carries no MAC address: not an ARP binding.
  ^Internet\s+\S+\s+\S+\s+Incomplete\s+\S+.*$$
  ^\s*$$
  ^.* -> Error "unrecognized show ip arp line"
