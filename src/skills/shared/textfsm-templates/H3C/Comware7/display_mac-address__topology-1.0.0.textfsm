Value MAC_ADDRESS ([0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4})
Value VLAN_ID (\S+)
Value STATE (\S+)
Value PORT (\S+)
Value AGING (\S+)

# One record per MAC entry (campus-wan, vpn-fabric and VSR labs, Comware 7.1). A header
# with no rows is an empty table.
Start
  ^MAC Address\s+VLAN ID\s+State\s+Port/Nickname\s+Aging\s*$$ -> Entries
  ^\s*$$
  ^. -> Error "unrecognized display mac-address line"

Entries
  ^${MAC_ADDRESS}\s+${VLAN_ID}\s+${STATE}\s+${PORT}\s+${AGING}\s*$$ -> Record
  ^\s*$$
  ^. -> Error "unrecognized MAC entry"
