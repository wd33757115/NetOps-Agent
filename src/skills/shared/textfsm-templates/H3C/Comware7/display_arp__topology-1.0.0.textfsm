Value IP_ADDRESS (\d+\.\d+\.\d+\.\d+)
Value MAC_ADDRESS ([0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4})
Value List VLAN_ID (\S+)
Value INTERFACE (\S+)
Value AGE (\S+)
Value TYPE (\S+)

# VLAN_ID holds the VLAN/VSI column; a long VSI name continues on the next line in
# that column, so it is a list whose parts are joined by the consumer.
Start
  ^\s*Type:\s+S-Static.*$$
  ^IP address\s+MAC address\s+VLAN/VSI name\s+Interface/Link ID\s+Aging\s+Type\s*$$
  ^\d+\.\d+\.\d+\.\d+\s -> Continue.Record
  ^${IP_ADDRESS}\s+${MAC_ADDRESS}\s+${VLAN_ID}\s+${INTERFACE}\s+${AGE}\s+${TYPE}\s*$$
  ^\s{20,}${VLAN_ID}\s*$$
  ^\s*$$
  ^.* -> Error "unrecognized display arp line"
