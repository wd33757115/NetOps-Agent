Value Filldown INTERFACE (\S+)
Value Required VRID (\d+)
Value STATE (\w+)
Value PRIORITY (\d+)
Value List VIRTUAL_IP (\d+\.\d+\.\d+\.\d+)
Value MASTER_IP (\S+)

# One record per interface and VRID (campus-wan lab, Comware 7.1). Two "Key : Value"
# pairs share a line; another VRID under the same interface starts its own record.
Start
  ^IPv4 Virtual Router Information:\s*$$
  ^\s*Running mode\s*:\s*\S+\s*$$
  ^\s*Total number of virtual routers\s*:\s*\d+\s*$$
  ^\s*Interface\s -> Continue.Record
  ^\s*Interface ${INTERFACE}\s*$$
  ^\s*VRID\s*: -> Continue.Record
  ^\s*VRID\s*:\s*${VRID}\s+Adver Timer\s*:\s*\d+\s*$$
  ^\s*Admin Status\s*:\s*\S+\s+State\s*:\s*${STATE}\s*$$
  ^\s*Config Pri\s*:\s*\d+\s+Running Pri\s*:\s*${PRIORITY}\s*$$
  ^\s*Virtual IP\s*:\s*${VIRTUAL_IP}(?:/\d+)?\s*$$
  ^\s*Master IP\s*:\s*${MASTER_IP}\s*$$
  ^\s+[A-Za-z][\w ./()-]*?\s*:\s.*$$
  ^\s*$$
  ^. -> Error "unrecognized display vrrp line"
